hdmilight: bulk payload boundaries for the MS2130 (espressif/usb_host_uvc 2.6.0)

The MS2130 sends MJPEG on a bulk endpoint in full 15,360-byte payloads. Each transfer is sized to the negotiated
payload, and a full transfer is treated as a payload boundary as well as a short one, so the next transfer starts
with a payload header. Applied at configure time by cmake/patched_component.cmake.

--- a/private_include/uvc_types_priv.h
+++ b/private_include/uvc_types_priv.h
@@ -56,6 +56,7 @@
     struct {
         uvc_host_stream_format_t vs_format;   // Format of the video stream
         uint32_t dwMaxVideoFrameSize;         // Maximum frame size of this vs_format
+        uint32_t dwMaxPayloadTransferSize;    // Negotiated payload transfer size (hdmilight: bulk payload boundary detection)
         uvc_host_frame_t *current_frame;      // Frame that is being written to
         bool streaming;                       // Flag whether stream is on/off
     } dynamic; // Dynamic members require a critical section
--- a/uvc_bulk.c
+++ b/uvc_bulk.c
@@ -123,6 +123,13 @@
     const uint8_t *payload_data  = payload;
     size_t payload_data_len      = transfer->actual_num_bytes;
 
+    // hdmilight patch: a payload ends with a short packet (original rule) OR when this transfer received a full
+    // payload (dwMaxPayloadTransferSize). Transfers are sized to exactly one payload (see uvc_transfers_allocate),
+    // so in the latter case the next transfer starts with a payload header even though no short packet was seen.
+    const uint32_t max_payload = UVC_ATOMIC_LOAD(uvc_stream->dynamic.dwMaxPayloadTransferSize);
+    const bool payload_end = (transfer->data_buffer_size > transfer->actual_num_bytes) ||
+                             (max_payload > 0 && transfer->actual_num_bytes >= max_payload);
+
     // Note for developers:
     // The order of SoF, Data, and EoF handling is intentional and represents a workaround for detecting EoF in the Bulk stream.
     // Normally, a complete Sample transfer includes two short packets: one marking the last data packet and another with the EoF header.
@@ -200,8 +207,8 @@
         // Add received data to frame buffer
         bulk_add_frame_data(uvc_stream, payload_data, payload_data_len);
 
-        // We got short packet in data section, this packet is EoF
-        if (transfer->data_buffer_size > transfer->actual_num_bytes) {
+        // We got short packet in data section (or a whole payload): the next transfer starts with a header
+        if (payload_end) {
             uvc_stream->single_thread.next_bulk_packet = UVC_STREAM_BULK_PACKET_EOF;
         }
         break;
@@ -221,8 +228,9 @@
         const bool start_of_frame = (uvc_stream->single_thread.current_frame_id != payload_header->bmHeaderInfo.frame_id);
 
         if (!start_of_frame && payload_header->bmHeaderInfo.end_of_frame == false && payload_data_len > 0) {
-            // This is not the end of frame, we collect more data
-            uvc_stream->single_thread.next_bulk_packet = UVC_STREAM_BULK_PACKET_DATA;
+            // This is not the end of frame, we collect more data. If this transfer itself ended the payload
+            // (short packet or a whole payload), the next transfer carries a header again.
+            uvc_stream->single_thread.next_bulk_packet = payload_end ? UVC_STREAM_BULK_PACKET_EOF : UVC_STREAM_BULK_PACKET_DATA;
             bulk_add_frame_data(uvc_stream, payload_data + payload_header->bHeaderLength, payload_data_len - payload_header->bHeaderLength);
             break;
         }
