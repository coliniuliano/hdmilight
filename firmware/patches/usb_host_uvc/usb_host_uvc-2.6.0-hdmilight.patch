+    if (!is_isoc && bulk_payload_size > 0) {
+        // hdmilight patch: BULK streams. The bulk state machine (uvc_bulk.c) finds payload boundaries by short
+        // packets *or* by a transfer that received a whole payload. For the latter to be exact, one transfer must
+        // hold exactly one payload (dwMaxPayloadTransferSize). Cameras whose payload size is a multiple of MPS
+        // (e.g. MacroSilicon MS2130: 15360 = 30 x 512) never send a short packet mid-frame, so any other transfer
+        // size leaves 12-byte payload headers inside the frame data.
+        if (transfer_size != 0 && transfer_size != bulk_payload_size) {
+            ESP_LOGW(TAG, "BULK: using negotiated payload size %" PRIu32 " as transfer size instead of requested %zu", bulk_payload_size, transfer_size);
+        }
+        transfer_size = bulk_payload_size;
+    }
