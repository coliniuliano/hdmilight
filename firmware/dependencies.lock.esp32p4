dependencies:
  espressif/cjson:
    component_hash: e788323270d90738662d66fffa910bfe1fba019bba087f01557e70c40485b469
    dependencies:
    - name: idf
      require: private
      version: '>=5.0'
    source:
      registry_url: https://components.espressif.com/
      type: service
    version: 1.7.19~2
  espressif/eppp_link:
    component_hash: c1369b37f2b0b427b198ae14e07e7547d3da92b95fe4dc7f949e5de560b35f21
    dependencies:
    - name: espressif/esp_serial_slave_link
      registry_url: https://components.espressif.com
      require: private
      version: ^1.1.0
    - name: idf
      require: private
      version: '>=5.2'
    source:
      registry_url: https://components.espressif.com
      type: service
    version: 1.1.6
  espressif/esp_hosted:
    dependencies:
    - name: cherry-embedded/cherryusb
      rules:
      - if: target in [esp32p4]
      - if: $CONFIG{ESP_HOSTED_HOST_USB_CHERRYUSB_MANIFEST} == 1
      version: '>=1.6.0'
    - name: espressif/esp_tinyusb
      rules:
      - if: target in [esp32s2, esp32s3, esp32s31]
      - if: $CONFIG{ESP_HOSTED_CP_TINYUSB_MANIFEST} == 1
      version: '*'
    - name: espressif/iot_usbh_rndis
      rules:
      - if: target in [esp32p4]
      - if: $CONFIG{ESP_HOSTED_HOST_USB_RNDIS_MANIFEST} == 1
      version: ^0.5.2
    - name: espressif/usb_host_cdc_acm
      rules:
      - if: target in [esp32p4]
      - if: $CONFIG{ESP_HOSTED_HOST_USB_CDC_ACM_MANIFEST} == 1
      version: '*'
    - name: idf
      version: '>=5.5'
    source:
      path: .patched/esp_hosted
      type: local
    targets:
    - esp32
    - esp32s2
    - esp32s3
    - esp32s31
    - esp32c2
    - esp32c3
    - esp32c5
    - esp32c6
    - esp32c61
    - esp32h2
    - esp32h4
    - esp32h21
    - esp32p4
    version: 3.1.0
  espressif/esp_serial_slave_link:
    component_hash: ac1776806de0a6e371c84e87898bb983e19ce62aa7f1e2e5c4a3b0234a575d2c
    dependencies:
    - name: idf
      require: private
      version: '>=5.0'
    source:
      registry_url: https://components.espressif.com
      type: service
    version: 1.1.2
  espressif/esp_wifi_remote:
    component_hash: faa185898a843b9d7d0456e4094a3b5f1491a48ddd57ce0e5179e13ac6243f2c
    dependencies:
    - name: espressif/esp_hosted
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: target in [esp32h2, esp32p4]
      version: '>=2.11'
    - name: espressif/wifi_remote_over_eppp
      registry_url: https://components.espressif.com
      require: private
      version: '>=0.1'
    - name: idf
      require: private
      version: '>=5.3'
    source:
      registry_url: https://components.espressif.com/
      type: service
    version: 1.6.5
  espressif/led_strip:
    component_hash: 027f68f2b57b0dca1d68dff6cc1139d9093825aa808c2bc3ca42bb2ce530fce9
    dependencies:
    - name: idf
      require: private
      version: '>=5.2'
    source:
      registry_url: https://components.espressif.com/
      type: service
    version: 3.1.1
  espressif/mdns:
    component_hash: 2fa43caa78cc170842255bc7bf71f306bc815cae12e9496bfb12372423019ac7
    dependencies:
    - name: idf
      require: private
      version: '>=5.0'
    source:
      registry_url: https://components.espressif.com/
      type: service
    version: 1.15.1
  espressif/usb:
    component_hash: 99eee72ea224d9117d4c342442717a1f20bf8112e2ab5d7d7038b827874f4c92
    dependencies:
    - name: idf
      require: private
      version: '>=5.5.3'
    source:
      registry_url: https://components.espressif.com/
      type: service
    targets:
    - esp32s2
    - esp32s3
    - esp32s31
    - esp32p4
    - esp32h4
    - linux
    version: 1.6.0
  espressif/usb_host_uvc:
    dependencies:
    - name: idf
      version: '>=5.0'
    - name: espressif/usb
      public: true
      rules:
      - if: idf_version >=6.0
      - if: target not in ["linux"]
      version: ^1.0.0
    source:
      path: .patched/usb_host_uvc
      type: local
    targets:
    - esp32s2
    - esp32s3
    - esp32p4
    - esp32h4
    - esp32s31
    - linux
    version: 2.6.0
  espressif/wifi_remote_over_eppp:
    component_hash: 1fd6968af20f0b19e421f6b519b0a8caf81d689afc3783b564c28559e45f66ef
    dependencies:
    - name: espressif/eppp_link
      registry_url: https://components.espressif.com
      require: private
      version: '>=0.1'
    - name: idf
      require: private
      version: '>=5.3'
    source:
      registry_url: https://components.espressif.com
      type: service
    version: 0.3.3
  idf:
    source:
      type: idf
    version: 6.1.0
direct_dependencies:
- espressif/cjson
- espressif/esp_hosted
- espressif/esp_wifi_remote
- espressif/led_strip
- espressif/mdns
- espressif/usb_host_uvc
- idf
manifest_hash: 737c0b3a1f17254f7ba4f92f365c18145ec1bb3db9db29caf0d98736051188d9
target: esp32p4
version: 3.0.0
