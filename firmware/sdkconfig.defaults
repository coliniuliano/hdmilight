# Common to both targets; per-chip settings are in sdkconfig.defaults.esp32p4 / .esp32s31 (picked by idf.py set-target).

# 16 MB flash on the ESP32-P4-Module, the NANO and the ESP32-S31-WROOM-3. Two 3 MB app slots for Wi-Fi updates (/api/update) with
# rollback: a new image that has no network 3 minutes after boot restarts and is reverted (app_main.c).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# PSRAM: frame buffers and decoded frames live here (mode/speed per target)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=150000

# USB host. MacroSilicon configuration descriptors exceed 1 KiB (4096 per the
# P4 capture projects); Bias IN per Espressif in esp-usb issue #279.
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y
# The ESP32-P4-Module-DEV-KIT's USB-A ports sit behind a CH334F hub (HOST jumper);
# the NANO's single USB-A does not need this but is unaffected by it.
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_UVC_INTERVAL_ARRAY_SIZE=16
# sskvm disables the EOH check for MacroSilicon payload headers
CONFIG_UVC_CHECK_PAYLOAD_HEADER_EOH=n

# Network on core 1 (capture, decode and the pipeline are pinned to core 0)
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y
# Socket budget: web server 9 (7 clients + listen + control), ESPHome API 4 (listen + 3 clients), network
# watchdog 2 (loopback self-check + ping), setup-AP DNS 1 = 16; 20 leaves headroom. lwIP's default of 10 left the
# web server refusing every request once the API server took the last socket.
CONFIG_LWIP_MAX_SOCKETS=20

# 1 ms tick for the smoothing clock
CONFIG_FREERTOS_HZ=1000
# per-core CPU load for the status page (one esp_timer read per context switch)
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# Bigger main stack for the pipeline init
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
