  (text "USB HS host (DM/DP, pads under the module) goes to the MS2130; IO33/IO34 are USB-Serial/JTAG to the USB-C." (at 20.32 21.59 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "0e08ccc3-3b73-55c4-b3d5-a0465c135df7"))
  (text "FL_* reach the MS2130 boot flash through R45-R48: leave floating unless programming it." (at 20.32 26.67 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "7a4ae4e1-f5b9-55bb-a888-808889eaf09e"))
